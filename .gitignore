# =============================================================================
# REPOSITORY SAFETY RULES — KEEP THIS FILE TRACKED
# =============================================================================
# Keep this file in Git so every clone protects credentials, virtual
# environments, live snapshots, private design documents, and local evidence.
# Review these rules before any broad git add or commit operation.
# =============================================================================

# Local design documents (submitted via Word / kept for local development)
ARCHITECTURE.md
docs/SYSTEM_DESIGN.md

# Diagram source files (render to PNG for assignment submission)
docs/diagrams/*.mmd

# Local assignment/demo evidence. Commit selected sanitized evidence only after
# explicit review, using git add -f for the chosen file.
docs/evidence/

# Local inventory override (optional; example file is committed)
data/inventory/inventory.json

# Credentials and secrets
credentials.json
data/credentials.json
*.credentials.json
.env
.env.*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# IDE and OS
.idea/
.vscode/
*.swp
.DS_Store

# Collected live snapshots (may contain sensitive device data)
snapshots/*
!snapshots/.gitkeep

# Local test outputs
.pytest_cache/
.coverage
htmlcov/

# Report drafts (submitted separately to UoPeople)
report/*.docx
report/*.pdf

.gitignore