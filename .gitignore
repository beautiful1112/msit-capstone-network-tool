# Public ignore rules for the Capstone repository (committed to GitHub).
# Private / machine-local ignores belong in .gitignore.local
# (applied via .git/info/exclude — never committed).

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# Secrets (keep in the public rules so every clone is protected)
credentials.json
data/credentials.json
*.credentials.json
.env
.env.*

# Live collection snapshots (may contain device data)
snapshots/*
!snapshots/.gitkeep

# IDE and OS
.idea/
.vscode/
*.swp
.DS_Store

# Test / coverage outputs
.pytest_cache/
.coverage
htmlcov/
