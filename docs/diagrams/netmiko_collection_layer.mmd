flowchart LR
    subgraph INPUT["Inputs"]
        INV[(Device Inventory)]
        CRED[(Local Credentials)]
    end

    subgraph NETMIKO["Netmiko SSH Layer"]
        CM[Connection Manager<br/>connect / retry / timeout]
        AUTH[Session Auth<br/>username + password]
        CMD[Command Runner<br/>send_command]
    end

    subgraph DEVICES["Lab Devices"]
        SW1[SW1<br/>10.1.1.1 / 10.2.2.1]
        R1[R1]
        R2[R2]
        R3[R3<br/>lo 8.8.8.8]
        R4[R4<br/>lo 1.1.1.1]
    end

    subgraph COMMANDS["Operational Commands"]
        C1[show ip route]
        C2[show ip interface brief]
        C3[show ip arp]
        C4[show running-config]
        C5[show cdp neighbors detail]
    end

    subgraph OUTPUT["Outputs"]
        SNAP[(Timestamped Snapshot Folder)]
        MAN[Collection Manifest<br/>success / failure per device]
    end

    INV --> CM
    CRED --> AUTH
    CM --> AUTH
    AUTH --> CMD
    CMD --> C1
    CMD --> C2
    CMD --> C3
    CMD --> C4
    CMD --> C5

    C1 & C2 & C3 & C4 & C5 --> SW1
    C1 & C2 & C3 & C4 & C5 --> R1
    C1 & C2 & C3 & C4 & C5 --> R2
    C1 & C2 & C3 & C4 & C5 --> R3
    C1 & C2 & C3 & C4 & C5 --> R4

    CMD --> SNAP
    CMD --> MAN
