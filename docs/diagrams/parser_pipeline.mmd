flowchart TB
    subgraph RAW["Raw CLI Output"]
        R1[ip_route.txt]
        R2[interfaces.txt]
        R3[arp.txt]
        R4[running_config.txt]
        R5[neighbors.txt]
    end

    subgraph PARSERS["Dedicated Parsers"]
        RP[Route Parser<br/>TextFSM / regex]
        IP[Interface Parser]
        AP[ARP Parser]
        CP[Config Parser<br/>static routes, OSPF costs]
        NP[Neighbour Parser<br/>CDP / LLDP]
    end

    subgraph MODELS["Structured Records"]
        M1[RouteEntry<br/>prefix, next-hop, metric, protocol]
        M2[InterfaceEntry<br/>name, IP, status]
        M3[ArpEntry<br/>IP, MAC, interface]
        M4[ConfigEntry<br/>static routes, OSPF cost lines]
        M5[NeighbourEntry<br/>local/remote device + interface]
    end

    subgraph OUT["Normalised Output"]
        NS[NetworkState Schema<br/>JSON-serialisable]
    end

    R1 --> RP --> M1
    R2 --> IP --> M2
    R3 --> AP --> M3
    R4 --> CP --> M4
    R5 --> NP --> M5

    M1 & M2 & M3 & M4 & M5 --> NS

    NS -->|primary truth for current path| ROUTE_NOTE[Route table drives<br/>forwarding analysis]
    NS -->|supporting context| CONFIG_NOTE[Config supports<br/>simulation inputs]
